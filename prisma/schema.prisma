generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FoundationAdminAuditLog {
  id            String   @id @default(uuid())
  commitHash    String?
  actionType    String   @default("GIT_PUSH")
  changedFiles  Json
  commitMessage String?
  createdAt     DateTime @default(now())
}

model FoundationAdminMetric {
  id         String   @id @default(uuid())
  ramUsageMb Float?
  cpuLoad    Float?
  status     String   @default("ONLINE")
  recordedAt DateTime @default(now())
}

model FoundationSystemLog {
  id             String   @id @default(uuid())
  level          String
  source         String
  message        String
  timestamp      String
  category       String   @default("FOUNDATION")
  severity       String   @default("INFO")
  fingerprint    String   @unique
  count          Int      @default(1)
  firstSeen      DateTime @default(now())
  lastSeen       DateTime @default(now())
  retentionUntil DateTime
  createdAt      DateTime @default(now())

  @@index([retentionUntil])
  @@index([category, severity, lastSeen])
}

model FoundationSourceCodeHistory {
  id          String   @id @default(uuid())
  filePath    String
  content     String
  versionHash String?
  updatedAt   DateTime @default(now())
}

// ==========================================
// ORBIS BRAIN MEMORY & KNOWLEDGE BASE
// ==========================================

// ১. Brain Knowledge (কোম্পানির স্থায়ী তথ্য, নিয়ম, প্রোডাক্ট ইত্যাদি)
model FoundationBrainKnowledge {
  id        String   @id @default(uuid())
  category  String
  content   String
  tags      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-reviewed, generalized knowledge only. This table is deliberately
// separate from historical Brain knowledge and conversational/user memory.
model FoundationLearnedKnowledge {
  id                String   @id @default(uuid())
  category          String
  content           String
  tags              String[] @default([])
  deduplicationHash String   @unique
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Metadata-only decision feedback for the Learning Loop. This table never
// stores prompts, answers, user identity, free-text corrections, or provider output.
model FoundationLearningEvent {
  id                 String   @id
  eventType          String
  decisionRoute      String
  decisionIntent     String
  decisionConfidence String
  evidenceRequired   Boolean
  decisionReason     String
  outcome            String
  feedbackCode       String
  occurredAt         DateTime
  receivedAt         DateTime @default(now())
  deduplicationHash  String   @unique

  @@index([receivedAt])
  @@index([decisionRoute, outcome])
}

// ২. User Memory (ইউজারদের সম্পর্কে যা যা শিখবে বা মনে রাখবে)
model FoundationUserMemory {
  id        String   @id @default(uuid())
  sessionId String
  factKey   String
  factValue String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// FOUNDATION PRODUCT MODEL REGISTRY
// ==========================================
//
// Product configuration is intentionally separate from customer accounting
// records. The Admin dashboard manages these definitions; a later public app
// may resolve only the PUBLISHED version.
model FoundationManagedProductModel {
  id          String   @id @default(uuid())
  slug        String   @unique
  displayName String
  category    String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions FoundationManagedProductModelVersion[]
  events   FoundationManagedProductModelEvent[]
}

model FoundationManagedProductModelVersion {
  id                String    @id @default(uuid())
  modelId           String
  sequence          Int
  lifecycle         String    @default("DRAFT")
  definition        Json
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  publishedAt       DateTime?
  reviewStatus      String    @default("NOT_RUN")
  reviewReport      Json?
  reviewedAt        DateTime?
  reviewedByAdminId String?

  model  FoundationManagedProductModel        @relation(fields: [modelId], references: [id], onDelete: Cascade)
  events FoundationManagedProductModelEvent[]

  @@unique([modelId, sequence])
  @@index([modelId, lifecycle])
}

// ==========================================
// LOTTERY ACCOUNTING CORE
// ==========================================
// Financial amounts are integer paise and percentage rates are basis points.
// Browser clients never access these server-owned tables directly.
model FoundationAccountingOrganization {
  id        String   @id @default(uuid())
  name      String
  tdsRateBps Int      @default(200)
  userLedgerStorage String @default("CLOUD")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parties           FoundationAccountingParty[]
  periods           FoundationLotteryAccountingPeriod[]
  documentSequences FoundationLotteryDocumentSequence[]
  stockMovement     FoundationLotteryStockMovement[]
  stockistEntries   FoundationLotteryStockistEntry[]
  sales             FoundationLotterySale[]
  payments          FoundationLotteryPayment[]
  settlements       FoundationLotterySettlement[]
  ledgerEntries     FoundationLotteryLedgerEntry[]
  auditEvents       FoundationLotteryAuditEvent[]
  entryClearances   FoundationLotteryEntryClearance[]
  expenseCategories FoundationAccountingExpenseCategory[]
  expenseProfiles   FoundationAccountingExpenseProfile[]
  expenseBills      FoundationAccountingExpenseBill[]
  expensePayments   FoundationAccountingExpensePayment[]
  customerBills     FoundationAccountingCustomerBill[]
}

model FoundationAccountingParty {
  id                String   @id @default(uuid())
  organizationId    String
  partyType         String
  name              String
  phone             String?
  uniqueCode        String   @unique
  ticketRatePaise   BigInt   @default(0)
  commissionRateBps Int      @default(0)
  tdsRateBps        Int      @default(0)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sales        FoundationLotterySale[]
  payments     FoundationLotteryPayment[]
  stockMovements FoundationLotteryStockMovement[]
  stockistEntries FoundationLotteryStockistEntry[]
  customerBills   FoundationAccountingCustomerBill[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model FoundationLotteryAccountingPeriod {
  id             String   @id @default(uuid())
  organizationId String
  label          String
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sales        FoundationLotterySale[]
  payments     FoundationLotteryPayment[]

  @@unique([organizationId, label])
  @@index([organizationId, startsAt, endsAt])
}

model FoundationLotteryDocumentSequence {
  id             String   @id @default(uuid())
  organizationId String
  financialYear  String
  documentType   String
  nextValue      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, financialYear, documentType])
  @@index([organizationId, financialYear])
}

model FoundationLotteryStockMovement {
  id               String   @id @default(uuid())
  organizationId   String
  partyId          String?
  sourceReceiptId  String?
  returnSession    String?
  movementType     String
  quantity         BigInt
  unitRatePaise    BigInt   @default(0)
  grossPurchasePaise BigInt @default(0)
  commissionPaise  BigInt   @default(0)
  tdsRateBps       Int      @default(0)
  tdsPaise         BigInt   @default(0)
  netPayablePaise  BigInt   @default(0)
  reference        String
  occurredAt       DateTime
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        FoundationAccountingParty? @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference, movementType])
  @@index([organizationId, occurredAt])
  @@index([partyId, occurredAt])
  @@index([sourceReceiptId])
}

model FoundationLotteryStockistEntry {
  id                      String   @id @default(uuid())
  organizationId          String
  partyId                 String
  reference               String
  purchaseQuantity        BigInt   @default(0)
  morningReturnQuantity   BigInt   @default(0)
  dayReturnQuantity       BigInt   @default(0)
  eveningReturnQuantity   BigInt   @default(0)
  totalReturnQuantity     BigInt   @default(0)
  netPurchaseQuantity     BigInt   @default(0)
  unitRatePaise           BigInt   @default(0)
  grossPurchasePaise      BigInt   @default(0)
  commissionPaise         BigInt   @default(0)
  tdsRateBps              Int      @default(0)
  tdsPaise                BigInt   @default(0)
  netPayablePaise         BigInt   @default(0)
  occurredAt              DateTime
  createdByAdminId        String
  updatedByAdminId        String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        FoundationAccountingParty @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, partyId, occurredAt])
  @@unique([organizationId, reference])
  @@index([organizationId, occurredAt])
  @@index([partyId, occurredAt])
}

model FoundationLotterySale {
  id                    String   @id @default(uuid())
  organizationId        String
  partyId               String
  periodId              String?
  reference             String
  dispatchQuantity      Int
  morningReturnQuantity Int      @default(0)
  dayReturnQuantity     Int      @default(0)
  eveningReturnQuantity Int      @default(0)
  returnQuantity        Int
  netTickets            Int
  ticketRatePaise       BigInt
  grossSalesPaise       BigInt
  commissionRateBps     Int
  commissionPaise       BigInt
  tdsRateBps            Int
  tdsPaise              BigInt
  netPayablePaise       BigInt
  status                String   @default("DRAFT")
  correctionOfSaleId    String?
  occurredAt            DateTime
  createdByAdminId      String
  createdAt             DateTime @default(now())

  organization FoundationAccountingOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        FoundationAccountingParty          @relation(fields: [partyId], references: [id], onDelete: Restrict)
  period       FoundationLotteryAccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  settlements  FoundationLotterySettlement[]

  @@unique([organizationId, reference])
  @@index([organizationId, occurredAt])
  @@index([organizationId, status, occurredAt])
  @@index([partyId, occurredAt])
  @@index([periodId])
  @@index([correctionOfSaleId])
}

model FoundationLotteryPayment {
  id               String   @id @default(uuid())
  organizationId   String
  partyId          String
  periodId         String?
  direction        String
  totalAmountPaise BigInt
  methodSplit      Json
  reference        String
  status           String   @default("POSTED")
  occurredAt       DateTime
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        FoundationAccountingParty          @relation(fields: [partyId], references: [id], onDelete: Restrict)
  period       FoundationLotteryAccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  settlements  FoundationLotterySettlement[]

  @@unique([organizationId, reference])
  @@index([organizationId, occurredAt])
  @@index([partyId, occurredAt])
  @@index([periodId])
}

model FoundationLotterySettlement {
  id               String   @id @default(uuid())
  organizationId   String
  saleId           String
  paymentId        String
  amountPaise      BigInt
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sale         FoundationLotterySale            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payment      FoundationLotteryPayment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([saleId, paymentId])
  @@index([organizationId, createdAt])
  @@index([paymentId])
}

model FoundationLotteryLedgerEntry {
  id               String   @id @default(uuid())
  organizationId   String
  transactionId    String
  sourceType       String
  sourceId         String
  lineNumber       Int
  accountCode      String
  side             String
  amountPaise      BigInt
  occurredAt       DateTime
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([transactionId, lineNumber])
  @@index([organizationId, occurredAt])
  @@index([sourceType, sourceId])
}

model FoundationLotteryAuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  eventType      String
  entityType     String
  entityId       String
  actorAdminId   String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// A clearance never deletes a party or an immutable accounting row. It marks
// a selected day's operational entries as replaced, so a new correction for
// that same date can be saved cleanly and the audit trail stays intact.
model FoundationLotteryEntryClearance {
  id               String   @id @default(uuid())
  organizationId   String
  occurredAt       DateTime
  scope            String
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt, scope])
}


model FoundationAccountingExpenseCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profiles     FoundationAccountingExpenseProfile[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model FoundationAccountingExpenseProfile {
  id                String   @id @default(uuid())
  organizationId    String
  categoryId        String
  name              String
  usualAmountPaise  BigInt   @default(0)
  scheduleType      String   @default("ONE_TIME")
  recurringStartsAt DateTime?
  note              String?
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization FoundationAccountingOrganization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     FoundationAccountingExpenseCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bills        FoundationAccountingExpenseBill[]
  payments     FoundationAccountingExpensePayment[]

  @@unique([organizationId, categoryId, name])
  @@index([organizationId, status])
  @@index([organizationId, scheduleType, status])
  @@index([categoryId])
}

model FoundationAccountingExpenseBill {
  id               String   @id @default(uuid())
  organizationId   String
  profileId        String
  amountPaise      BigInt
  reference        String
  billingMonth     String?
  occurredAt       DateTime
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile      FoundationAccountingExpenseProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@unique([organizationId, profileId, billingMonth])
  @@index([profileId, occurredAt])
  @@index([organizationId, occurredAt])
}

model FoundationAccountingExpensePayment {
  id               String   @id @default(uuid())
  organizationId   String
  profileId        String
  totalAmountPaise BigInt
  cashPaise        BigInt   @default(0)
  bankPaise        BigInt   @default(0)
  reference        String
  occurredAt       DateTime
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  profile      FoundationAccountingExpenseProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([profileId, occurredAt])
  @@index([organizationId, occurredAt])
}

model FoundationAccountingCustomerBill {
  id               String   @id @default(uuid())
  organizationId   String
  partyId          String
  quantity         BigInt
  unitRatePaise    BigInt
  amountPaise      BigInt
  reference        String
  occurredAt       DateTime
  createdByAdminId String
  createdAt        DateTime @default(now())

  organization FoundationAccountingOrganization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  party        FoundationAccountingParty        @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([organizationId, reference])
  @@index([partyId, occurredAt])
  @@index([organizationId, occurredAt])
}

// Audit events contain only release metadata. They never contain financial
// entries, customer credentials, prompts, or AI replies.
model FoundationManagedProductModelEvent {
  id             String   @id @default(uuid())
  modelId        String
  modelVersionId String?
  action         String
  actorAdminId   String
  metadata       Json?
  createdAt      DateTime @default(now())

  model   FoundationManagedProductModel         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  version FoundationManagedProductModelVersion? @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)

  @@index([modelId, createdAt])
  @@index([modelVersionId])
}
