generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FoundationAdminAuditLog {
  id            String   @id @default(uuid())
  commitHash    String?
  actionType    String   @default("GIT_PUSH")
  changedFiles  Json
  commitMessage String?
  createdAt     DateTime @default(now())
}

model FoundationAdminMetric {
  id         String   @id @default(uuid())
  ramUsageMb Float?
  cpuLoad    Float?
  status     String   @default("ONLINE")
  recordedAt DateTime @default(now())
}
