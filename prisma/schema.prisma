generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FoundationAdminAuditLog {
  id            String   @id @default(uuid())
  commitHash    String?
  actionType    String   @default("GIT_PUSH")
  changedFiles  Json
  commitMessage String?
  createdAt     DateTime @default(now())
}

model FoundationAdminMetric {
  id         String   @id @default(uuid())
  ramUsageMb Float?
  cpuLoad    Float?
  status     String   @default("ONLINE")
  recordedAt DateTime @default(now())
}

model FoundationSystemLog {
  id        String   @id @default(uuid())
  level     String
  source    String
  message   String
  timestamp String
  createdAt DateTime @default(now())
}

model FoundationSourceCodeHistory {
  id          String   @id @default(uuid())
  filePath    String // ফাইলের সম্পূর্ণ পাথ (যেমন: src/admin/SystemLogManager.tsx)
  content     String // ফাইলের ভেতরের সম্পূর্ণ কোড
  versionHash String? // ভার্সন ট্র্যাকিংয়ের জন্য (ঐচ্ছিক)
  updatedAt   DateTime @default(now()) // আপডেট হওয়ার সময়
}
