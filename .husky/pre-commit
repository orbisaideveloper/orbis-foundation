#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "ORBIS: lightweight pre-commit safety check..."

git diff --cached --check || {
  echo "ORBIS: whitespace/diff error in staged changes."
  exit 1
}

if git diff --cached --name-only | grep -q '^\.orbis-backup/'; then
  echo "ORBIS: .orbis-backup/ must not be committed."
  exit 1
fi

git diff --cached --name-only --diff-filter=ACMR |
while IFS= read -r file
do
  case "$file" in
    *.cjs)
      [ -f "$file" ] && node --check "$file" || exit 1
      ;;
    *.sh)
      [ -f "$file" ] && bash -n "$file" || exit 1
      ;;
  esac
done || {
  echo "ORBIS: staged syntax check failed."
  exit 1
}

echo "ORBIS: pre-commit safety PASS."
echo "Full quality is handled by 'orbis verify', not repeated here."
